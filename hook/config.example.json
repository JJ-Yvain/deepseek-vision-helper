{
  "provider": "agnes",
  "batch_provider": "mimo",
  "fallback_provider": "mimo",
  "batch_threshold": 3,
  "max_images": 4,
  "per_image_max_chars": 2000,
  "total_max_chars": 8000,
  "max_image_bytes": 10485760,
  "max_tokens": 4000,
  "timeout_seconds": 90,
  "log_max_bytes": 1048576,
  "skip_when_multimodal": false,
  "default_question": "请识别这张图片：如果包含文字请完整提取；如果是界面、报错页面或图表，请说明其内容与含义。",
  "providers": {
    "zhipu": {
      "base_url": "https://open.bigmodel.cn/api/paas/v4/chat/completions",
      "api_key": "YOUR_ZHIPU_API_KEY",
      "model": "glm-4.6v-flash",
      "header": "Authorization",
      "auth_prefix": "Bearer "
    },
    "agnes": {
      "base_url": "https://apihub.agnes-ai.com/v1/chat/completions",
      "api_key": "YOUR_AGNES_API_KEY",
      "model": "agnes-2.5-flash",
      "header": "Authorization",
      "auth_prefix": "Bearer "
    },
    "mimo": {
      "base_url": "https://opencode.ai/zen/go/v1/chat/completions",
      "api_key": "YOUR_MIMO_API_KEY",
      "model": "mimo-v2.5",
      "header": "Authorization",
      "auth_prefix": "Bearer "
    },
    "mimo-direct": {
      "base_url": "https://api.xiaomimimo.com/v1/chat/completions",
      "api_key": "YOUR_MIMO_DIRECT_API_KEY",
      "model": "mimo-v2.5",
      "header": "Authorization",
      "auth_prefix": "Bearer "
    }
  }
}